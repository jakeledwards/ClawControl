# Local Capacitor plugins — track source + native code, exclude build output
!plugins/
plugins/*/dist/
plugins/*/node_modules/
plugins/*/.build/
plugins/*/.swiftpm/
plugins/*/Package.resolved
!plugins/*/ios/
!plugins/*/android/
plugins/*/android/build/
plugins/*/android/.gradle/
/openclaw/
/skills
upload-keyfile
.claude/settings.local.json
